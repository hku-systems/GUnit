From 88423ae903978f22af4fe859a23ffbe5dbaae520 Mon Sep 17 00:00:00 2001
From: Qi Hu <github@spcsky.com>
Date: Thu, 1 Jan 2026 23:13:25 +0800
Subject: [PATCH 1/3] introspection: print cycles and add async perf features

Signed-off-by: Qi Hu <github@spcsky.com>
---
 .../libafl/src/monitors/stats/perf_stats.rs   | 45 ++++++++++++++++---
 1 file changed, 38 insertions(+), 7 deletions(-)

diff --git a/crates/libafl/src/monitors/stats/perf_stats.rs b/crates/libafl/src/monitors/stats/perf_stats.rs
index 343bc85d..928da933 100644
--- a/crates/libafl/src/monitors/stats/perf_stats.rs
+++ b/crates/libafl/src/monitors/stats/perf_stats.rs
@@ -72,6 +72,12 @@ pub enum PerfFeature {
     /// Time spent getting the feedback from `is_interesting` from all objectives
     GetObjectivesInterestingAll = 9,
 
+    /// Time spent polling for completed tasks (async targets)
+    PollCompletedTasks = 10,
+
+    /// Time spent finding a pending task by id (async targets)
+    FindPendingTask = 11,
+
     /// Used as a counter to know how many elements are in [`PerfFeature`]. Must be the
     /// last value in the enum.
     Count, // !! No more values here since Count is last! !!
@@ -96,6 +102,8 @@ impl From<PerfFeature> for usize {
             PerfFeature::GetObjectivesInterestingAll => {
                 PerfFeature::GetObjectivesInterestingAll as usize
             }
+            PerfFeature::PollCompletedTasks => PerfFeature::PollCompletedTasks as usize,
+            PerfFeature::FindPendingTask => PerfFeature::FindPendingTask as usize,
             PerfFeature::Count => PerfFeature::Count as usize,
         }
     }
@@ -115,6 +123,8 @@ impl From<usize> for PerfFeature {
             7 => PerfFeature::PostExecObservers,
             8 => PerfFeature::GetFeedbackInterestingAll,
             9 => PerfFeature::GetObjectivesInterestingAll,
+            10 => PerfFeature::PollCompletedTasks,
+            11 => PerfFeature::FindPendingTask,
             _ => panic!("Unknown PerfFeature: {val}"),
         }
     }
@@ -350,6 +360,8 @@ impl fmt::Display for ClientPerfStats {
     fn fmt(&self, f: &mut fmt::Formatter) -> Result<(), fmt::Error> {
         // Calculate the elapsed time from the monitor
         let elapsed: f64 = self.elapsed_cycles() as f64;
+        let elapsed_cycles = self.elapsed_cycles();
+        let mut accounted_cycles: u64 = 0;
 
         // Calculate the percentages for each benchmark
         let scheduler_percent = self.scheduler as f64 / elapsed;
@@ -359,11 +371,15 @@ impl fmt::Display for ClientPerfStats {
         let mut other_percent = 1.0;
         other_percent -= scheduler_percent;
         other_percent -= manager_percent;
+        accounted_cycles = accounted_cycles.saturating_add(self.scheduler);
+        accounted_cycles = accounted_cycles.saturating_add(self.manager);
 
         // Create the formatted string
         writeln!(
             f,
-            "  {scheduler_percent:6.4}: Scheduler\n  {manager_percent:6.4}: Manager"
+            "  {scheduler_percent:6.4} ({:>12} cyc): Scheduler\n  {manager_percent:6.4} ({:>12} cyc): Manager",
+            self.scheduler,
+            self.manager
         )?;
 
         // Calculate each stage
@@ -372,9 +388,9 @@ impl fmt::Display for ClientPerfStats {
             // Write the stage header
             writeln!(f, "  Stage {stage_index}:")?;
 
-            for (feature_index, feature) in features.iter().enumerate() {
+            for (feature_index, feature_cycles) in features.iter().enumerate() {
                 // Calculate this current stage's percentage
-                let feature_percent = *feature as f64 / elapsed;
+                let feature_percent = *feature_cycles as f64 / elapsed;
 
                 // Ignore this feature if it isn't used
                 if feature_percent == 0.0 {
@@ -383,12 +399,17 @@ impl fmt::Display for ClientPerfStats {
 
                 // Update the other percent by removing this current percent
                 other_percent -= feature_percent;
+                accounted_cycles = accounted_cycles.saturating_add(*feature_cycles);
 
                 // Get the actual feature from the feature index for printing its name
-                let feature: PerfFeature = feature_index.into();
+                let perf_feature: PerfFeature = feature_index.into();
 
                 // Write the percentage for this feature
-                writeln!(f, "    {feature_percent:6.4}: {feature:?}")?;
+                writeln!(
+                    f,
+                    "    {feature_percent:6.4} ({:>12} cyc): {perf_feature:?}",
+                    feature_cycles
+                )?;
             }
         }
 
@@ -405,12 +426,22 @@ impl fmt::Display for ClientPerfStats {
 
             // Update the other percent by removing this current percent
             other_percent -= feedback_percent;
+            accounted_cycles = accounted_cycles.saturating_add(*feedback_time);
 
             // Write the percentage for this feedback
-            writeln!(f, "    {feedback_percent:6.4}: {feedback_name}")?;
+            writeln!(
+                f,
+                "    {feedback_percent:6.4} ({:>12} cyc): {feedback_name}",
+                feedback_time
+            )?;
         }
 
-        write!(f, "  {other_percent:6.4}: Not Measured")?;
+        let other_cycles = elapsed_cycles.saturating_sub(accounted_cycles);
+        write!(
+            f,
+            "  {other_percent:6.4} ({:>12} cyc): Not Measured",
+            other_cycles
+        )?;
 
         Ok(())
     }
-- 
